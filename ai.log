3d-christmasstarbox is set up
Saved to environment
runs-on: windows
# One-time setup (e.g., install system tools, global CLIs).
initialize: |
  choco install openscad -y --no-progress
knowledge:
  - name: render-stls
    contents: |
      & "C:\Program Files\OpenSCAD\openscad.com" -o front.stl -D 'part=\"front\"' star_box.scad
      # Use openscad.com (console wrapper), not openscad.exe; repeat with part="back"/"base".
 

